\@writefile{toc}{\contentsline {subsection}{\numberline {5.1}Main Analysis: FIBRATC14.MX ($n = 62$)}{8}{subsection.5.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces FIBRATC14.MX backtesting results ($n = 62$, 95\% VaR). $C = \hat  {p} - \alpha $ is the conservatism metric; negative values indicate conservatism. The CP-CI is the 95\% Clopper--Pearson exact confidence interval for the breach rate.}}{9}{table.caption.9}\protected@file@percent }
\newlabel{tab:fibraresults}{{3}{9}{FIBRATC14.MX backtesting results ($n = 62$, 95\% VaR). $C = \hat {p} - \alpha $ is the conservatism metric; negative values indicate conservatism. The CP-CI is the 95\% Clopper--Pearson exact confidence interval for the breach rate}{table.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Kupiec $p$-value as a function of the breach count $x$ for $n = 62$ and $\alpha = 0.05$. The diamond markers show the observed breach count of each model. At $x = 6$ the model is not rejected ($p = 0.132$); at $x = 7$ it is rejected ($p = 0.049$). Three models (GARCH-Normal, XGBoost-Pure, XGBoost-Ensemble) sit at $x = 7$, one breach past the 5\% threshold. A single additional breach---one trading day out of 62---flips the test outcome.}}{10}{figure.caption.10}\protected@file@percent }
\newlabel{fig:staircase}{{3}{10}{Kupiec $p$-value as a function of the breach count $x$ for $n = 62$ and $\alpha = 0.05$. The diamond markers show the observed breach count of each model. At $x = 6$ the model is not rejected ($p = 0.132$); at $x = 7$ it is rejected ($p = 0.049$). Three models (GARCH-Normal, XGBoost-Pure, XGBoost-Ensemble) sit at $x = 7$, one breach past the 5\% threshold. A single additional breach---one trading day out of 62---flips the test outcome}{figure.caption.10}{}}
