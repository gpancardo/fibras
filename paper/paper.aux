\newlabel{fig:size}{{2}{9}{Distribution of Kupiec $p$-values under the null hypothesis ($H_0: p = 0.05$) for $n = 62$ and $n = 95$, based on 5,000 binomial draws. Deviation from the uniform distribution (dashed line) indicates size distortion. The empirical rejection rate (fraction below 0.05) is shown in each panel}{figure.caption.8}{}}
\@writefile{toc}{\contentsline {section}{\numberline {6}Empirical Results}{9}{section.6}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {6.1}Main Analysis: FIBRATC14.MX ($n = 62$)}{9}{subsection.6.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces FIBRATC14.MX backtesting results ($n = 62$, 95\% VaR). $C = \hat  {p} - \alpha $ is the conservatism metric; negative values indicate conservatism. The CP-CI is the 95\% Clopper--Pearson exact confidence interval for the breach rate.}}{10}{table.caption.9}\protected@file@percent }
\newlabel{tab:fibraresults}{{3}{10}{FIBRATC14.MX backtesting results ($n = 62$, 95\% VaR). $C = \hat {p} - \alpha $ is the conservatism metric; negative values indicate conservatism. The CP-CI is the 95\% Clopper--Pearson exact confidence interval for the breach rate}{table.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Kupiec $p$-value as a function of the breach count $x$ for $n = 62$ and $\alpha = 0.05$. The diamond markers show the observed breach count of each model. XGBoost-$t$ sits at $x = 6$ ($p = 0.132$), one breach below the rejection threshold; at $x = 7$ the test rejects ($p = 0.049$). GARCH-Normal, XGBoost-Pure, and XGBoost-Ensemble each sit at $x = 7$, one breach past the 5\% threshold. A single additional breach---one trading day out of 62---flips the test outcome.}}{11}{figure.caption.10}\protected@file@percent }
\newlabel{fig:staircase}{{3}{11}{Kupiec $p$-value as a function of the breach count $x$ for $n = 62$ and $\alpha = 0.05$. The diamond markers show the observed breach count of each model. XGBoost-$t$ sits at $x = 6$ ($p = 0.132$), one breach below the rejection threshold; at $x = 7$ the test rejects ($p = 0.049$). GARCH-Normal, XGBoost-Pure, and XGBoost-Ensemble each sit at $x = 7$, one breach past the 5\% threshold. A single additional breach---one trading day out of 62---flips the test outcome}{figure.caption.10}{}}
