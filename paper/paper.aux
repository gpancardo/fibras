\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Conservatism metric $C = \hat  {p} - \alpha $ for each model on FIBRATC14.MX ($n = 62$, 95\% VaR). Negative values (blue/green) indicate conservative models; positive values (red) indicate anti-conservative models. GARCH-$t$ is the only model with $C \approx 0$.}}{12}{figure.caption.12}\protected@file@percent }
\newlabel{fig:conservatism}{{4}{12}{Conservatism metric $C = \hat {p} - \alpha $ for each model on FIBRATC14.MX ($n = 62$, 95\% VaR). Negative values (blue/green) indicate conservative models; positive values (red) indicate anti-conservative models. GARCH-$t$ is the only model with $C \approx 0$}{figure.caption.12}{}}
