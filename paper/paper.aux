\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Exact operating characteristics of the Kupiec POF test and the exact binomial test at $\alpha = 0.05$. ``Size'' is the rejection rate when $p_{\text  {true}} = \alpha $; ``Power'' is the rejection rate at the indicated true breach rate.}}{6}{table.caption.6}\protected@file@percent }
\newlabel{tab:power}{{2}{6}{Exact operating characteristics of the Kupiec POF test and the exact binomial test at $\alpha = 0.05$. ``Size'' is the rejection rate when $p_{\text {true}} = \alpha $; ``Power'' is the rejection rate at the indicated true breach rate}{table.caption.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Power curves of the Kupiec POF test for $n = 62$, $n = 95$, and $n = 250$, computed exactly from the binomial distribution.}}{7}{figure.caption.7}\protected@file@percent }
